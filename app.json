{
  "expo": {
    "name": "Daybreak",
    "slug": "daybreak-alarm",
    "scheme": "daybreak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/art/moon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daybreak.alarm",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "Daybreak uses alarms to wake you at the times you choose, even when your iPhone is silenced or in Focus.",
        "NSMotionUsageDescription": "Daybreak uses motion only during your shake-to-wake challenge.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.daybreak.alarm",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/art/moon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-notifications", { "color": "#BDB0F5" }],
      "expo-sensors"
    ]
  }
}
