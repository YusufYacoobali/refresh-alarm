{
  "expo": {
    "name": "Refresh",
    "slug": "daybreak-alarm",
    "scheme": "daybreak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yacoobali.alarm",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "UIBackgroundModes": [],
        "NSAlarmKitUsageDescription": "Refresh uses alarms to wake you at the times you choose, even when your iPhone is silenced or in Focus.",
        "NSMotionUsageDescription": "Refresh uses motion only during your shake-to-wake challenge.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yacoobali.alarm",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#BDB0F5",
          "sounds": [
            "./assets/audio/alarms/daybreak_lofi.wav",
            "./assets/audio/alarms/daybreak_wake_up.wav",
            "./assets/audio/alarms/daybreak_classic_bell.wav",
            "./assets/audio/alarms/daybreak_retro_clock.wav",
            "./assets/audio/alarms/daybreak_short_ring.wav",
            "./assets/audio/alarms/daybreak_digital_beep.wav",
            "./assets/audio/alarms/daybreak_pulse.wav",
            "./assets/audio/alarms/daybreak_bright_alarm.wav",
            "./assets/audio/alarms/daybreak_electronic.wav",
            "./assets/audio/alarms/daybreak_steady_alarm.wav",
            "./assets/audio/alarms/daybreak_rooster.wav",
            "./assets/audio/alarms/daybreak_funny_alarm.wav",
            "./assets/audio/alarms/daybreak_arcade.wav",
            "./assets/audio/alarms/daybreak_biohazard.wav",
            "./assets/audio/alarms/daybreak_emergency.wav",
            "./assets/audio/alarms/daybreak_adhan_alafasy_fajr.wav",
            "./assets/audio/alarms/daybreak_adhan.wav"
          ]
        }
      ],
      "expo-sensors",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your alarm background.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-refresh-alarm.cjs",
      "./plugins/with-app-blocking.cjs"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bbf01fbf-12d2-4c92-b039-568f37708151"
      }
    }
  }
}
